# Ish topdim — muhit o'zgaruvchilari (namuna, haqiqiy qiymatlarsiz).
# Lokal: cp .env.example .env.local · Production: Vercel → Settings → Environment Variables.
# Belgilar: [MAJBURIY] / [IXTIYORIY] · [PUBLIC] — brauzerga chiqadi (NEXT_PUBLIC_*), [SERVER] — faqat serverda.
# Sirlarni chatga, issue'ga yoki kodga yozmang. Kalit sizsa: docs/SECURITY_RUNBOOK.md §3.

# --- Supabase (Project Settings → API) -------------------------------------------------------------
# [MAJBURIY][PUBLIC] loyiha manzili
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# [MAJBURIY][PUBLIC] publishable (yoki eski anon) kalit — RLS bilan himoyalangan
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# [MAJBURIY prod][SERVER] secret (service role) kalit — RLS'ni chetlab o'tadi; hech qachon brauzerga chiqmasin
SUPABASE_SERVICE_ROLE_KEY=

# --- Ilova -----------------------------------------------------------------------------------------------
# [MAJBURIY prod][SERVER] saytning tashqi manzili (havolalar, CSRF tekshiruvi)
APP_URL=http://localhost:3000
# [MAJBURIY prod][PUBLIC] xuddi shu manzil (https bo'lsa Secure cookie va HSTS yoqiladi)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# [MAJBURIY prod][SERVER] /api/cron/* uchun Bearer token (openssl rand -hex 32)
CRON_SECRET=
# [TAVSIYA][SERVER] limit/xavfsizlik hodisalari uchun HMAC kaliti (openssl rand -hex 32). Bo'sh bo'lsa CRON_SECRET ishlatiladi
SECURITY_PEPPER=
# [TAVSIYA][SERVER] kirish kodlari HMAC kaliti (openssl rand -hex 32). Bo'sh bo'lsa service kalit ishlatiladi
LOGIN_CODE_SECRET=

# --- Telegram (BotFather) — kirish kodi, Mini App, bildirishnomalar ------------------------------------
# [MAJBURIY prod][SERVER] bot tokeni (veb-kirish kodlari ham bot orqali yuboriladi)
TELEGRAM_BOT_TOKEN=
# [MAJBURIY prod][SERVER] bot username (@ siz)
TELEGRAM_BOT_USERNAME=
# [MAJBURIY prod][SERVER] webhook maxfiy sarlavhasi (openssl rand -hex 32), setWebhook'da secret_token
TELEGRAM_WEBHOOK_SECRET=

# --- Admin panel --------------------------------------------------------------------------------------------
# [IXTIYORIY][SERVER] admin panel faqat shu hostda ochiladi (asosiy saytda /admin — 404), masalan admin.example.uz
ADMIN_HOST=
# [IXTIYORIY][SERVER] egasining tasdiqlangan telefon(lar)i, vergul bilan: +998901234567 (birinchi super_admin)
SUPER_ADMIN_PHONES=
# [IXTIYORIY][SERVER] false — admin UI butunlay o'chiq
ADMIN_UI_ENABLED=

# --- AI (faqat serverda; bo'sh bo'lsa AI tugmalari ko'rinmaydi, asosiy xizmat ishlayveradi) -----------
# [IXTIYORIY][SERVER] Gemini (ustun) yoki Claude
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
# [IXTIYORIY][SERVER] kasb rasmlari (matnli AI kalitidan alohida)
IMAGE_GEN_API_KEY=
IMAGE_GEN_MODEL=gemini-2.5-flash-image
# [FAQAT TEST][SERVER] mock serverlar uchun; production'da (VERCEL_ENV=production) e'tiborsiz qoldiriladi
# GEMINI_BASE_URL=
# IMAGE_GEN_BASE_URL=
# TELEGRAM_API_BASE=

# --- To'lovlar (hozir o'chiq; yoqish — admin panel/app_settings va BILLING_ENABLED) ------------------
# [IXTIYORIY][SERVER]
BILLING_ENABLED=
PAYME_MERCHANT_ID=
PAYME_KEY=
# 1 — Payme test muhiti
PAYME_TEST=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# --- SEO, huquqiy, mobil ----------------------------------------------------------------------------------
# [IXTIYORIY][SERVER] Search Console / Yandex tasdiqlash kodi (meta content)
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
# [IXTIYORIY][SERVER] maxfiylik siyosatidagi aloqa email
SUPPORT_EMAIL=
# [IXTIYORIY][SERVER] huquqiy sahifalardagi operator rekvizitlari
LEGAL_OPERATOR=
# [IXTIYORIY][SERVER] Android TWA: paket nomi va Play Console → App signing SHA-256 (vergul bilan)
ANDROID_PACKAGE_NAME=uz.ishtopdim.app
ANDROID_SHA256_CERT_FINGERPRINTS=

# --- Faqat lokal ishlab chiqish -----------------------------------------------------------------------------
# npm run db:local / db:test (lokal PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/ishuz_dev

# --- GitHub Actions Secrets (bu faylga emas!) ---------------------------------------------------------
# SUPABASE_DB_URL       — shifrlangan kunlik zaxira (Session pooler satri, parol bilan)
# BACKUP_AGE_RECIPIENT  — age OCHIQ kaliti (age1...); yopiq kalit egasida oflayn
# GitHub Variables: BACKUP_DISABLED=true — zaxirani ataylab o'chirish; BACKUP_MAX_AGE_HOURS (sukut 26)
